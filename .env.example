# WISDOM - AI & Environment Configuration

# Google Gemini API Key (Optional: for live generative answers in RAG assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://user:password@localhost:5432/wisdom_db

# eRTMAC WITSML / OPC-UA Telemetry Stream Endpoint
ERTMAC_STREAM_URL=wss://ertmac.oilindia.in/live/witsml
